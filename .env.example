# =====================================================================
# VIGÍA CAUCA — Plantilla de variables de entorno
# Copia este archivo como .env y completa los valores antes de levantar
# el stack con: docker compose up -d --build
# =====================================================================

# =====================
# POSTGRES — USUARIOS
# =====================
USUARIOS_DB=micro_usuarios
USUARIOS_DB_USER=postgres
USUARIOS_DB_PASSWORD=postgres
USUARIOS_DB_URL=jdbc:postgresql://postgres-usuarios:5432/micro_usuarios

# =====================
# POSTGRES — UBICACIONES
# =====================
UBICACIONES_DB=micro_ubicaciones
UBICACIONES_DB_USER=postgres
UBICACIONES_DB_PASSWORD=postgres
UBICACIONES_DB_URL=jdbc:postgresql://postgres-ubicaciones:5432/micro_ubicaciones

# =====================
# POSTGRES — NOVEDADES
# =====================
NOVEDADES_DB=novedades_db
NOVEDADES_DB_USER=postgres
NOVEDADES_DB_PASSWORD=postgres
NOVEDADES_DB_URL=jdbc:postgresql://postgres-novedades:5432/novedades_db

# =====================
# POSTGRES — REPORTES
# =====================
REPORTES_DB=estadisticas_db
REPORTES_DB_USER=postgres
REPORTES_DB_PASSWORD=postgres
REPORTES_DB_URL=jdbc:postgresql://postgres-reportes:5432/estadisticas_db

# =====================
# RABBITMQ
# =====================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# =====================
# KEYCLOAK
# =====================
KEYCLOAK_USER=admin
KEYCLOAK_PASSWORD=admin
KEYCLOAK_REALM=security-realm-dev
KEYCLOAK_REALM_MASTER=master
KEYCLOAK_ADMIN_CLI=admin-cli
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/security-realm-dev
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/security-realm-dev/protocol/openid-connect/certs
KEYCLOAK_TOKEN_URL=http://keycloak:8080/realms/security-realm-dev/protocol/openid-connect/token
KEYCLOAK_LOGOUT_URL=http://keycloak:8080/realms/security-realm-dev/protocol/openid-connect/logout
KEYCLOAK_CLIENT_ID=api-gateway
KEYCLOAK_CLIENT_SECRET_GATEWAY=<client-secret-del-api-gateway-en-keycloak>
KEYCLOAK_CLIENT_SECRET_USUARIOS=<client-secret-del-micro-usuarios-en-keycloak>

# =====================
# SMTP (para recuperar contraseña vía Keycloak)
# =====================
# Usa una "Contraseña de aplicación" de Gmail (16 caracteres, SIN espacios).
# Generala en: https://myaccount.google.com/apppasswords
# Si dejas SMTP_HOST vacío, el init NO configura el correo (reset no funcionará).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_STARTTLS=false
SMTP_AUTH=true
SMTP_FROM=tu-correo@gmail.com
SMTP_FROM_DISPLAY_NAME=Vigia Cauca
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=<contraseña-de-aplicacion-de-16-caracteres-sin-espacios>

# =====================
# ROLES
# =====================
ROL_ADMIN=admin
ROL_OPERADOR=operador

# =====================
# PUERTOS
# =====================
GATEWAY_PORT=8080
USUARIOS_PORT=8081
UBICACIONES_PORT=8082
NOVEDADES_PORT=5003
REPORTES_PORT=5004
FRONTEND_PORT=5173

# =====================
# STORAGE
# =====================
EVIDENCIAS_PATH=/app/evidencias
REPORTES_TEMP_DIR=/app/reportes-temp

# =====================
# RABBITMQ — COLAS Y EXCHANGES
# =====================
RABBITMQ_QUEUE_NOVEDADES_NOTIF=cola.novedades.notificaciones
RABBITMQ_QUEUE_NOVEDADES_STATS=cola.novedades.estadisticas
RABBITMQ_EXCHANGE_NOVEDADES=exchange.novedades
RABBITMQ_RK_NOVEDADES=rk.novedades.estadisticas

# =====================
# CLIENTES HTTP INTERNOS
# =====================
CLIENTS_NOVEDADES_BASE_URL=http://micro-novedades:5003
CLIENTS_USUARIOS_BASE_URL=http://micro-usuarios:8081

# =====================
# FRONTEND
# =====================
# Docker (nginx reverse proxy): dejar vacíos → usa rutas relativas
# Desarrollo local sin Docker: poner http://localhost:8080 y http://localhost:8180
VITE_API_GATEWAY_URL=
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=security-realm-dev
VITE_KEYCLOAK_CLIENT_ID=api-gateway
VITE_API_MODE=gateway
VITE_API_NOVEDADES_URL=http://localhost:5003
VITE_API_REPORTES_URL=http://localhost:5004
VITE_API_UBICACIONES_URL=http://localhost:8082
